# Leave unset for local development — Vite's dev-server proxy (see
# vite.config.js) forwards /api/* straight to the PHP backend on :8000.
#
# Set this only for production builds where the frontend is deployed
# separately from the backend, e.g.:
# VITE_API_URL=https://api.jonathanphotography.com/api
#
# Same-host production (InfinityFree: site in htdocs, PHP in htdocs/backend)
# needs neither VITE_API_URL nor VITE_BACKEND_URL: builds default to
# /backend/api and /backend. Development values live in .env.development and
# are not used by `npm run build`.

# Client-side upload preparation. The PHP exporter independently enforces the
# authoritative values configured in backend/.env.
VITE_PUBLIC_PREVIEW_MAX_EDGE=1600
VITE_PUBLIC_PREVIEW_QUALITY=78

# Optional: Google Maps Embed API key for the footer studio map. Restrict the key
# to your domain in Google Cloud. When unset, the footer uses Google's keyless
# query embed for the saved studio address plus a "View on Google Maps" link.
# VITE_GOOGLE_MAPS_EMBED_KEY=
