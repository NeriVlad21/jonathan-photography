# Copy this file to .env and fill in real values.
# Never commit the real .env file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jonathan_photography
DB_USER=root
DB_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
