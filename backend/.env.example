# Copy this file to .env and fill in real values.
# Never commit the real .env file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jonathan_photography
DB_USER=root
DB_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=mereziko@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=mereziko@gmail.com
SMTP_FROM_NAME="Jonathan Photography"
SMTP_ADMIN_EMAIL=mereziko@gmail.com

APP_URL=http://localhost/jonathan-photography/backend
FRONTEND_URL=http://localhost:5173
APP_ENV=development

# Random 32+ character string used to sign the CSRF token / session name.
APP_SECRET=change-this-to-a-long-random-string

# Public portfolio preview export. A 1400px edge is supported for stricter
# delivery; 1600 is the conservative default for large laptop displays.
PUBLIC_PREVIEW_ENABLED=true
PUBLIC_PREVIEW_MAX_EDGE=1600
PUBLIC_PREVIEW_QUALITY=78
WATERMARK_MODE=none
PREVIEW_CREATOR="Jonathan Photography"
PREVIEW_COPYRIGHT="Copyright Jonathan Photography. All rights reserved."
PREVIEW_LICENSING_URL=http://localhost:5173/contact
